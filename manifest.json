{
    "manifest_version": 3,
    "name": "Bad Dog, No Chrome",
    "version": "1.1",
    "description": "Closes new windows when 3+ are already open, and keeps each window to 10 tabs max.",
    "permissions": [
        "storage",
        "tabs"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_popup": "popup.html",
        "default_title": "Bad Dog, No Chrome"
    }
}
